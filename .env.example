# x-digest の設定。値は各マシンのローカルのみ。.env は git 管理外。
#
# データとブラウザプロファイルの置き場。既定は ~/Library/Application Support/x-digest/。
# profile/ には生きた X セッションの資格情報が入るため、リポジトリ内に向けないこと。
# X_DIGEST_DATA_DIR="$HOME/Library/Application Support/x-digest"

# Stage 2 (ダイジェスト生成) の設定
# X_DIGEST_MODEL=claude-sonnet-5
# X_DIGEST_FALLBACK_MODEL=claude-haiku-4-5-20251001
# X_DIGEST_MAX_BUDGET_USD=0.50

# ダイジェストに渡す窓の大きさ
# X_DIGEST_WINDOW_DAYS=7
# X_DIGEST_MAX_ITEMS=60
